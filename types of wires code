#include <stdio.h>

int main()
{
    int media, bit_rate, fault, noise, termination;
    int nodes, wires;
    float bus_length;
    int suitable = 1;

    char *medium, *noise_rejection, *radiation, *application;

    printf("CAN Physical Media Selection\n");
    printf("1. Single Wire CAN\n");
    printf("2. Differential Twisted Pair CAN\n");
    printf("3. Twisted Pair with Screen\n");

    printf("Select medium: ");
    scanf("%d", &media);

    printf("Enter bit rate (125, 250, 500, 1000 kbps): ");
    scanf("%d", &bit_rate);

    printf("Enter bus length (metres): ");
    scanf("%f", &bus_length);

    printf("Enter number of nodes: ");
    scanf("%d", &nodes);

    printf("Fault (0=None, 1=Open, 2=Short): ");
    scanf("%d", &fault);

    printf("Enter noise level (0-100): ");
    scanf("%d", &noise);

    printf("Termination (0=Absent, 1=Present): ");
    scanf("%d", &termination);

    switch (media)
    {
        case 1:
            medium = "Single Wire CAN";
            wires = 1;
            noise_rejection = "LOW";
            radiation = "HIGH";
            application = "Low-speed, low-cost systems";
            break;

        case 2:
            medium = "Differential Twisted Pair";
            wires = 2;
            noise_rejection = "HIGH";
            radiation = "LOW";
            application = "Automotive and industrial CAN";
            break;

        case 3:
            medium = "Twisted Pair with Screen";
            wires = 3;
            noise_rejection = "VERY HIGH";
            radiation = "VERY LOW";
            application = "High-noise industrial environments";
            break;

        default:
            printf("Invalid medium selection!\n");
            return 0;
    }

    printf("\n--- CAN Bus Analysis ---\n");
    printf("Selected Medium : %s\n", medium);
    printf("Number of Wires : %d\n", wires);
    printf("Noise Rejection : %s\n", noise_rejection);
    printf("Radiation       : %s\n", radiation);
    printf("Bit Rate        : %d kbps\n", bit_rate);
    printf("Bus Length      : %.1f m\n", bus_length);
    printf("Number of Nodes : %d\n", nodes);

    /* Check bit rate and approximate bus length */
    if ((bit_rate == 1000 && bus_length > 40) ||
        (bit_rate == 500 && bus_length > 100) ||
        (bit_rate == 250 && bus_length > 250) ||
        (bit_rate == 125 && bus_length > 500) ||
        (bit_rate != 125 && bit_rate != 250 &&
         bit_rate != 500 && bit_rate != 1000))
    {
        suitable = 0;
    }

    if (nodes < 1 || nodes > 32)
        suitable = 0;

    if (fault != 0)
    {
        suitable = 0;

        if (fault == 1)
            printf("Fault Effect     : Open circuit detected\n");
        else if (fault == 2)
            printf("Fault Effect     : Short circuit detected\n");
        else
            printf("Fault Effect     : Invalid fault selection\n");
    }
    else
    {
        printf("Fault Effect     : No fault\n");
    }

    if (media != 1 && termination == 0)
    {
        suitable = 0;
        printf("Termination     : NOT OK\n");
    }
    else
    {
        printf("Termination     : OK / Not required\n");
    }

    if (noise > 70 && media == 1)
        suitable = 0;

    if (noise < 0 || noise > 100)
        suitable = 0;

    printf("Application     : %s\n", application);

    if (suitable)
        printf("Bus Status      : SUITABLE\n");
    else
        printf("Bus Status      : NOT SUITABLE\n");

    printf("\n--- Alternative Media ---\n");
    printf("Single Wire: Low cost, low noise immunity\n");
    printf("Twisted Pair: High noise immunity, low radiation\n");
    printf("Twisted + Screen: Very high noise protection\n");

    return 0;
}
